{
  "name": "piece-bag",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "マッチ3 × デッキ構築ローグ（仮題：ピースバッグ）",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
